{
	"private": true,
	"packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
	"engines": {
		"node": ">=24.x"
	},
	"type": "module",
	"scripts": {
		"clean": "rimraf coverage && pnpm -r --parallel --silent run clean",
		"setup-dev": "pnpm --filter pandora-common --silent run build",
		"postinstall": "node .hooks/postinstall.mjs",
		"ci": "pnpm run build && pnpm run lint:root && pnpm run type-check:test && pnpm run test --ci --coverage && pnpm run test-e2e && pnpm run coverage:collect",
		"deploy": "pnpm run build && pnpm run deploy-client-rsync",
		"deploy-client": "pnpm --filter pandora-client-web run build && pnpm run deploy-client-rsync",
		"deploy-client-rsync": "rsync -rltOvcP --delete-delay ./pandora-client-web/dist/ ../pandora-client-web/dist",
		"lint": "pnpm -r --parallel run lint",
		"lint:root": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" eslint --max-warnings 0 .",
		"lint:fix": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" eslint --fix .",
		"type-check": "pnpm -r --parallel run '/type-check:.*/'",
		"type-check:test": "pnpm -r --parallel run '/type-check:test.*/'",
		"test": "jest",
		"test-e2e": "pnpm run -C pandora-tests type-check && pnpm run -C pandora-tests playwright-setup && pnpm run -C pandora-tests test-e2e && pnpm run -C pandora-tests coverage:report",
		"coverage:collect": "node .hooks/coverage-collect.cjs",
		"build": "pnpm -r run build",
		"dev": "pnpm --filter pandora-common run build && pnpm -r --parallel run dev",
		"pandora-cli": "pnpm --filter pandora-cli run pandora-cli"
	},
	"dependencies": {
		"js-yaml": "5.4.2"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@jest/globals": "30.5.2",
		"@stylistic/eslint-plugin": "5.10.0",
		"cross-env": "10.1.0",
		"eslint": "9.39.5",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"jest": "30.5.2",
		"jest-environment-jsdom": "30.5.2",
		"nyc": "18.0.0",
		"rimraf": "6.1.3",
		"ts-jest": "29.4.14",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0"
	}
}
