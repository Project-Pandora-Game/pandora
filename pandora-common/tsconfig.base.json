{
	"compilerOptions": {
		"target": "ES2024",
		"lib": [
			"ES2024"
		],
		"types": [],
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"noEmit": true,
		"noEmitOnError": true,
		"sourceMap": true,
		"declaration": false,
		"stripInternal": true,
		"removeComments": true,
		"strict": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"isolatedModules": true,
	},
	"typeAcquisition": {
		"enable": false
	}
}
